VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Origen canónico (OAuth PKCE): debe coincidir con Site URL en Supabase y dominio principal.
# Producción: https://www.moonsharedliving.com
# VITE_SITE_URL=https://www.moonsharedliving.com

# Solo servidor (Vercel): importación/exportación CSV, pipeline de notificaciones
# Supabase → Project Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY=

# OneSignal (cliente + servidor)
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
# ONESIGNAL_APP_ID=your-onesignal-app-id
# ONESIGNAL_REST_API_KEY=

# Observabilidad cliente (Sentry). Si VITE_SENTRY_DSN está vacío, no se inicializa.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=habitus-app@0.0.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Brevo email transaccional
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=hello@moonsharedliving.com
# BREVO_SENDER_NAME=: moon shared living

# Hardening opcional del API /api/notify/event
# NOTIFY_INTERNAL_SECRET=

# Tareas programadas de la VPS (nunca exponer con prefijo VITE_)
# Genera con: openssl rand -hex 32
# CRON_SECRET=

# Verificación híbrida (solo servidor; nunca usar prefijo VITE_)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_IDENTITY_SUCCESS_URL=http://localhost:5173/verificacion?stripe=complete
# STRIPE_IDENTITY_CANCEL_URL=http://localhost:5173/verificacion?stripe=canceled
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_DEFAULT_MODEL=openai/gpt-4o-mini
# AI_MATCH_MODEL=openai/gpt-4o-mini
# AI_SAFETY_MODEL=openai/gpt-4o-mini
# AI_VISION_MODEL=openai/gpt-4o
# VERIFICATION_RETENTION_DAYS=30

# Playwright (npm run test:e2e)
# E2E_BASE_URL=http://localhost:5173
# E2E_PASSWORD=HabitusTest!2026
