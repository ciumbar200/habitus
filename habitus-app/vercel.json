{
  "installCommand": "cd .. && npm install && cd habitus-app",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "moonsharedliving.com" }],
      "destination": "https://www.moonsharedliving.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.moonsharedliving.com/api/:path*"
    },
    {
      "source": "/((?!assets/|api/|brand/|marketing/|hero-listings/|blog/|robots\\.txt$|sitemap\\.xml$|.*\\.(?:jpg|jpeg|png|webp|svg|ico|gif|woff2?|txt|xml|json|js|css|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
