{
  "name": "habitus-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "dev:mobile": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "node scripts/open-ios.mjs",
