    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/node": "3.0.1",
    "expo": "^56.0.5",
    "expo-asset": "^56.0.15",
    "expo-auth-session": "^56.0.12",
    "expo-blur": "~15.0.8",
    "expo-constants": "^56.0.16",
